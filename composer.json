{
    "name": "linkrobins/flarum-swoop",
    "description": "Account emails for your Flarum forum, sent through Link Robins with one key. No SMTP, no DNS.",
    "keywords": [
        "flarum",
        "email",
        "smtp",
        "mail"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "LinkRobins\\Swoop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LinkRobins\\Swoop\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Swoop",
            "category": "feature",
            "icon": {
                "name": "fas fa-paper-plane",
                "backgroundColor": "#1a2535",
                "color": "#07adcc"
            }
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
